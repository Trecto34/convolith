{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convolith.example/spec/v1/conversation.schema.json",
  "title": "convolith conversation aggregate v1",
  "description": "One conversation summary as written to data/aggregates/conversations.jsonl.zst. Derived from the ledger, regenerable at any time. Mirrors src/model.rs::Conversation. The versioned session aggregate (src/model.rs::Session) shares the same shape but is keyed by `session_id` and always carries `conversation_id`; see $defs/session.",
  "type": "object",
  "required": [
    "schema_version",
    "conversation_id",
    "provider",
    "application",
    "event_count"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "conversation_id": { "$ref": "#/$defs/conversation_id" },
    "session_id": { "$ref": "#/$defs/session_id" },
    "provider": { "type": "string" },
    "application": { "type": "string" },
    "title": { "type": "string" },
    "model": { "type": "string" },
    "agent": { "type": "string" },
    "machine_id": { "type": "string" },
    "project_id": { "type": "string" },
    "repository_id": { "type": "string" },
    "working_directory": { "type": "string" },
    "started_at": { "$ref": "#/$defs/rfc3339_utc" },
    "ended_at": { "$ref": "#/$defs/rfc3339_utc" },
    "event_count": { "type": "integer", "minimum": 0 },
    "source_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_id" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "conversation_id": { "type": "string", "pattern": "^cv_[0-9a-f]{24}$" },
    "session_id": { "type": "string", "pattern": "^se_[0-9a-f]{24}$" },
    "source_id": { "type": "string", "pattern": "^src_[0-9a-f]{24}$" },
    "rfc3339_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "session": {
      "title": "convolith session aggregate v1",
      "description": "Mirrors src/model.rs::Session; same fields as the conversation aggregate plus session_id, minus model/repository_id/metadata.",
      "type": "object",
      "required": [
        "schema_version",
        "session_id",
        "conversation_id",
        "provider",
        "application",
        "event_count"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "session_id": { "$ref": "#/$defs/session_id" },
        "conversation_id": { "$ref": "#/$defs/conversation_id" },
        "provider": { "type": "string" },
        "application": { "type": "string" },
        "title": { "type": "string" },
        "agent": { "type": "string" },
        "machine_id": { "type": "string" },
        "project_id": { "type": "string" },
        "working_directory": { "type": "string" },
        "started_at": { "$ref": "#/$defs/rfc3339_utc" },
        "ended_at": { "$ref": "#/$defs/rfc3339_utc" },
        "event_count": { "type": "integer", "minimum": 0 },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_id" }
        }
      }
    }
  }
}